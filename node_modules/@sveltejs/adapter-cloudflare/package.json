{
  "name": "@sveltejs/adapter-cloudflare",
  "version": "8.0.0",
  "description": "Adapts SvelteKit applications for Cloudflare Workers or Cloudflare Pages",
  "keywords": [
    "adapter",
    "cloudflare pages",
    "deploy",
    "hosting",
    "svelte",
    "sveltekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltejs/kit.git",
    "directory": "packages/adapter-cloudflare"
  },
  "license": "MIT",
  "homepage": "https://svelte.dev/docs/kit/adapter-cloudflare",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "index.d.ts",
  "files": [
    "src/virtual-cloudflare-workers.js",
    "files/worker.js",
    "index.js",
    "utils.js",
    "index.d.ts"
  ],
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@rolldown/pluginutils": "^1.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/kit": "^3.0.0",
    "@types/node": "^22.19.19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.0-next.0",
    "wrangler": "^4.118.0"
  },
  "scripts": {
    "lint": "oxfmt --check .",
    "format": "oxfmt --write .",
    "check": "pnpm tsc-native && pnpm tsc-native --project files/tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "pnpm -r --workspace-concurrency 1 --filter=\"./test/**\" test",
    "test": "pnpm test:unit && pnpm test:e2e",
    "tsc-native": "node node_modules/@typescript/native/bin/tsc"
  }
}